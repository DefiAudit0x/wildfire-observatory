rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public map reports: readable by everyone, writable only by the server
    // (server writes bypass rules via the Admin SDK service account).
    match /reports/{report} {
      allow read: if true;
      allow write: if false;
    }

    // Email subscribers: private — server only.
    match /subscribers/{subscriber} {
      allow read, write: if false;
    }

    // Badge codes (volunteer/team credentials): private — server only.
    match /badgeCodes/{code} {
      allow read, write: if false;
    }

    // SOS emergency calls: private — server only.
    match /trappedSos/{id} {
      allow read, write: if false;
    }

    // Encrypted SOS identity profiles: private — server only.
    match /sosProfiles/{deviceId} {
      allow read, write: if false;
    }

    // Per-device notifications: private — server only.
    match /notifications/{id} {
      allow read, write: if false;
    }

    // Civil-protection units: private — server only (writes via Admin SDK).
    match /units/{unit} {
      allow read, write: if false;
    }

    // Staff accounts (agents/commanders): private — server only.
    match /users/{user} {
      allow read, write: if false;
    }

    // Daily duty rosters per unit: private — server only (writes via Admin SDK).
    match /units/{unit}/rosterDays/{date} {
      allow read, write: if false;
    }

    // Team Mode (Phase 1): registered field teams, their join codes, their
    // members (including GPS snapshots) and mission locks. All four are
    // server-only — member positions and principal bindings never become
    // client-readable through the public SDK.
    match /teams/{team} {
      allow read, write: if false;
    }

    match /teamJoinCodes/{code} {
      allow read, write: if false;
    }

    match /teamMembers/{member} {
      allow read, write: if false;
    }

    match /teamMissions/{mission} {
      allow read, write: if false;
    }
  }
}
