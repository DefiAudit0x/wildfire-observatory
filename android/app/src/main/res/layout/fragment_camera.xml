<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_camera.xml — v3.0 Professional UI (restoration-complete)
    M3 floating-pill design KEPT, plus the v2.9.0 evidentiary HUD RESTORED
    (zero-regression rule): compass chip + stamp toggle + alignment estimate
    on top, the crosshair frame the stamp draws at capture in the center,
    and the manual heading/pitch sliders + GPS/BEARING/PITCH status line at
    the bottom. Restored controls are styled with the M3 palette tokens.
    (start-end mirror automatically in RTL).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- RESTORED (v2.9.0): the crosshair — the frame the stamp draws at capture -->
    <View
        android:id="@+id/camera_crosshair"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_crosshair" />

    <!-- RESTORED (v2.9.0): evidentiary HUD top bar — compass + stamp toggle,
         then the alignment-estimate chip -->
    <LinearLayout
        android:id="@+id/camera_telemetry_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|fill_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/camera_compass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/camera_compass_none"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/camera_stamp_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/camera_stamp_on"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/camera_alignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/camera_alignment_no_fix"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:elevation="4dp" />
    </LinearLayout>

    <!-- Top floating hint pill -->
    <TextView
        android:id="@+id/camera_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="176dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="@string/camera_hint"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:elevation="4dp" />

    <!-- RESTORED (v2.9.0): manual overrides + status line — the no-sensor
         path stamps MANUAL like the web; sits above the action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|fill_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="122dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_manual_heading_hint"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/camera_heading_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_red"
                android:thumbTint="@color/accent_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/camera_manual_pitch_hint"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/camera_pitch_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_amber"
                android:thumbTint="@color/accent_amber" />
        </LinearLayout>

        <TextView
            android:id="@+id/camera_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/camera_status_fmt"
            android:textColor="@color/text_hint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Action Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|fill_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#B30B1220"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/camera_flip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="13dp"
            android:text="@string/camera_flip"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/camera_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:elevation="8dp"
            android:contentDescription="@string/camera_shutter_desc" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/camera_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="13dp"
            android:text="@string/camera_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
