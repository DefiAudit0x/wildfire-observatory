<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.0 — full-bleed in-app camera. PreviewView under dark chrome:
     bottom row = flip pill / ember shutter dead-center / close pill
     (start-end mirror automatically in RTL), hint pill floats above the
     row. Every control sits inside the parent's inset padding (the
     activity pads the container with system bars already). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1220">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/camera_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="118dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/camera_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|fill_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/camera_flip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/camera_flip"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/camera_shutter"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_shutter_button"
            android:elevation="6dp"
            android:contentDescription="@string/camera_shutter_desc" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/camera_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/camera_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
