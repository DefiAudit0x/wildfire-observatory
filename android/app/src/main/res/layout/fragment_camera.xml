<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 — in-app camera with enhanced preview and floating pill controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top floating hint pill -->
    <TextView
        android:id="@+id/camera_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="128dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="@string/camera_hint"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:elevation="4dp" />

    <!-- Bottom Action Controls Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|fill_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#B30B1220"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/camera_flip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="13dp"
            android:text="@string/camera_flip"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/camera_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:elevation="8dp"
            android:contentDescription="@string/camera_shutter_desc" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/camera_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="13dp"
            android:text="@string/camera_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
