<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_native_main.xml — v3.0 Professional UI Shell
    CoordinatorLayout enables Snackbar anchoring above BottomNav.
    BottomNav uses Observatory.BottomNav style with active indicator.
    Edge-to-edge insets applied in NativeMainActivity.onCreate().
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false">

    <!-- Fragment host fills all space above the bottom nav -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/actionBarSize"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Divider above bottom nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:background="@color/border_subtle" />

    <!-- Bottom Navigation — styled via Observatory.BottomNav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/nav_bg"
        app:elevation="8dp"
        app:itemActiveIndicatorColor="@color/nav_indicator"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

