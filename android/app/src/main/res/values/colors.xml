<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1B5E20</color>

    <!-- v2.8.0 (S2 UI parity): the native shell now mirrors the WEB console's
         zinc/red glassmorphism token-for-token (src/index.css + Tailwind
         palette). Same hues, same translucency levels, same semantics — a
         screenshot of either surface should read as the same product. -->

    <!-- Base surfaces (web: body #0a0505, panels zinc-900/950) -->
    <color name="bg">#0A0505</color>
    <color name="surface">#18181B</color>            <!-- zinc-900 -->
    <color name="surface_alt">#0F0D0F</color>        <!-- zinc-950 lifted -->
    <color name="surface_recessed">#09090B</color>   <!-- zinc-950 -->

    <!-- Glass fills (web: bg-black/60 headers, bg-zinc-900/70 panels) -->
    <color name="glass_fill">#990A0505</color>       <!-- black/60 over bg -->
    <color name="glass_fill_strong">#CC0A0505</color><!-- black/80 tab bar -->
    <color name="glass_card_top">#D918181B</color>   <!-- zinc-900/85 -->
    <color name="glass_card_bottom">#B30F0D0F</color><!-- zinc-950/70 -->

    <!-- Borders (web: border-white/10, red tints at 20/40%) -->
    <color name="border">#26262B</color>             <!-- zinc-800 -->
    <color name="border_glass">#1AFFFFFF</color>     <!-- white/10 -->
    <color name="border_glass_soft">#14FFFFFF</color><!-- white/8 -->
    <color name="border_red_soft">#33EF4444</color>  <!-- red-500/20 -->
    <color name="border_red_strong">#66EF4444</color><!-- red-500/40 -->

    <!-- Text (web: slate-50 primary, slate-300 secondary, gray-400 muted) -->
    <color name="text_primary">#F8FAFC</color>
    <color name="text_secondary">#CBD5E1</color>
    <color name="text_muted">#9CA3AF</color>
    <color name="text_faint">#71717A</color>         <!-- zinc-500 -->

    <!-- Accents (web primary = red-600; status = emerald/amber/cyan/orange) -->
    <color name="accent_red">#DC2626</color>         <!-- red-600 -->
    <color name="accent_red_bright">#EF4444</color>  <!-- red-500 -->
    <color name="accent_red_deep">#991B1B</color>    <!-- red-800 -->
    <color name="accent_green">#10B981</color>
    <color name="accent_green_bright">#34D399</color>
    <color name="accent_amber">#F59E0B</color>
    <color name="accent_amber_bright">#FBBF24</color>
    <color name="accent_cyan">#22D3EE</color>
    <color name="accent_orange">#F97316</color>      <!-- severity: high -->

    <!-- Legacy aliases kept for earlier code paths (values re-tinted) -->
    <color name="text_secondary_legacy">#CBD5E1</color>
</resources>
