<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v2.16.0 (brand alignment): dark console shell re-tinted to the official
         brand guidelines of the Algerian Observatory for Forest Fires and
         Disasters. Brand palette (from the brand book):
           #006233 green   — primary / identity / verified
           #1B4332 deep green — safe zones, safe actions
           #D21034 red     — EMERGENCY only (alerts, SOS, evacuation)
           #FF6B35 orange  — warnings / advisories / pending
           #8B4513 brown   — extreme danger tier (level 5 scale end)
           #FFFFFF white   — text on brand fills
         Surfaces stay dark (emergency-console legibility at night, in smoke),
         but shifted from zinc/red-black to a deep forest black so the green
         identity reads instead of the old ember-red cast. -->

    <!-- Brand primitives (never re-tint these; they are the identity) -->
    <color name="brand_green">#006233</color>
    <color name="brand_green_deep">#1B4332</color>
    <color name="brand_red">#D21034</color>
    <color name="brand_orange">#FF6B35</color>
    <color name="brand_brown">#8B4513</color>
    <color name="brand_white">#FFFFFF</color>

    <color name="ic_launcher_background">@color/brand_green</color>

    <!-- Base surfaces (forest black: green-tinted near-black, not warm red) -->
    <color name="bg">#070B09</color>
    <color name="surface">#121A16</color>            <!-- lifted card -->
    <color name="surface_alt">#0C120F</color>        <!-- lifted panel -->
    <color name="surface_recessed">#090D0B</color>   <!-- wells / inputs -->

    <!-- Glass fills (translucent layered panels over bg) -->
    <color name="glass_fill">#99070B09</color>       <!-- headers: bg/60 -->
    <color name="glass_fill_strong">#CC070B09</color><!-- tab bar: bg/80 -->
    <color name="glass_card_top">#D9121A16</color>   <!-- card top: surface/85 -->
    <color name="glass_card_bottom">#B30C120F</color><!-- card bottom: alt/70 -->

    <!-- Borders -->
    <color name="border">#1F2B24</color>             <!-- forest hairline -->
    <color name="border_glass">#1AFFFFFF</color>     <!-- white/10 -->
    <color name="border_glass_soft">#14FFFFFF</color><!-- white/8 -->
    <color name="border_green_soft">#33006233</color><!-- brand green/20 -->
    <color name="border_green_strong">#66006233</color><!-- brand green/40 -->
    <color name="border_red_soft">#33D21034</color>  <!-- brand red/20 -->
    <color name="border_red_strong">#66D21034</color><!-- brand red/40 -->

    <!-- Text -->
    <color name="text_primary">#F8FAFC</color>
    <color name="text_secondary">#CBD5E1</color>
    <color name="text_muted">#9CA3AF</color>
    <color name="text_faint">#71717A</color>

    <!-- Semantic accents (mapped onto the brand palette).
         accent_red    = emergency (brand red)      accent_green = verified/safe
         accent_amber  = warning/pending (brand orange)
         accent_orange = severity high (brand orange)
         accent_brown  = extreme tier               accent_cyan  = mesh/network -->
    <color name="accent_red">@color/brand_red</color>
    <color name="accent_red_bright">#E63A55</color>  <!-- brand red lifted for text on dark -->
    <color name="accent_red_deep">#8F0B23</color>    <!-- brand red pressed / gradient end -->
    <color name="accent_green">@color/brand_green</color>
    <color name="accent_green_bright">#2E9E5B</color><!-- brand green lifted for text on dark -->
    <color name="accent_green_deep">@color/brand_green_deep</color>
    <color name="accent_amber">@color/brand_orange</color>
    <color name="accent_amber_bright">#FF8A5C</color>
    <color name="accent_orange">@color/brand_orange</color>
    <color name="accent_brown">@color/brand_brown</color>
    <color name="accent_cyan">#22D3EE</color>        <!-- mesh/telemetry only; not a brand hue -->

    <!-- 5-level fire danger scale (brand book "Fire Danger Level Indicator") -->
    <color name="danger_1_low">#C5D9BF</color>
    <color name="danger_2_moderate">#8DB63C</color>
    <color name="danger_3_high">#FF6B35</color>
    <color name="danger_4_very_high">#F04E1F</color>
    <color name="danger_5_extreme">#D21034</color>

    <!-- Legacy aliases kept for earlier code paths -->
    <color name="text_secondary_legacy">#CBD5E1</color>
</resources>
