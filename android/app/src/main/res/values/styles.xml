<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v2.16.0 (brand alignment): Material3 dark shell on the brand palette.
         Primary = brand green (identity, verified, default actions);
         red is reserved for emergency semantics (SOS, evacuate, alerts).
         Window background = forest black; nav/status bars share it
         (edge-to-edge insets handled in code). -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/brand_white</item>
        <item name="colorSecondary">@color/accent_green_bright</item>
        <item name="colorError">@color/brand_red</item>
        <item name="colorOnError">@color/brand_white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainer">@color/surface_alt</item>
        <item name="colorOutline">@color/border_glass</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Typography scale — mirrors the web's font classes (Cairo/slate scale;
         bold-heavy headers, muted captions). The empty Obs root exists because
         dotted style names inherit an implicit parent that must resolve. -->
    <style name="Obs" />

    <style name="Obs.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Obs.SectionLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Obs.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Obs.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Obs.NavIndicator">
        <item name="android:color">@color/brand_green</item>
        <item name="android:alpha">0.28</item>
    </style>

    <style name="Obs.FieldLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
