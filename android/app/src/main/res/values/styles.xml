<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════════════════
         AppTheme — Material3 Dark, Observatory Palette v3.0
    ═══════════════════════════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary = Danger Red (fires, SOS) -->
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_red_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_red_on_container</item>

        <!-- Secondary = Safe Green (safezones, connected) -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_container</item>

        <!-- Tertiary = Mesh Cyan (connectivity info) -->
        <item name="colorTertiary">@color/accent_cyan</item>
        <item name="colorOnTertiary">@color/bg</item>
        <item name="colorTertiaryContainer">@color/accent_cyan_container</item>
        <item name="colorOnTertiaryContainer">@color/accent_cyan_on_container</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>

        <!-- Outline -->
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- Error -->
        <item name="colorError">@color/accent_red</item>
        <item name="colorOnError">@color/text_on_danger</item>
        <item name="colorErrorContainer">@color/accent_red_container</item>
        <item name="colorOnErrorContainer">@color/accent_red_on_container</item>

        <!-- Window chrome -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>

        <!-- Components -->
        <item name="materialCardViewStyle">@style/Observatory.CardView</item>
        <item name="textInputStyle">@style/Observatory.TextInput</item>
        <item name="materialButtonStyle">@style/Observatory.Button.Primary</item>
        <item name="bottomNavigationStyle">@style/Observatory.BottomNav</item>
        <item name="chipStyle">@style/Observatory.Chip</item>

        <!-- EditText cursor/handle -->
        <item name="android:textColorHighlight">#4422D3EE</item>
    </style>

    <!-- ── Shape Appearances ────────────────────────────────── -->
    <style name="ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ── Cards ────────────────────────────────────────────── -->
    <style name="Observatory.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="rippleColor">@color/ripple_on_surface</item>
    </style>

    <style name="Observatory.CardView.Elevated" parent="Observatory.CardView">
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Observatory.CardView.Danger" parent="Observatory.CardView">
        <item name="cardBackgroundColor">@color/accent_red_container</item>
        <item name="strokeColor">@color/accent_red_dim</item>
    </style>

    <style name="Observatory.CardView.Warning" parent="Observatory.CardView">
        <item name="cardBackgroundColor">@color/accent_amber_container</item>
        <item name="strokeColor">@color/accent_amber_dark</item>
    </style>

    <style name="Observatory.CardView.Info" parent="Observatory.CardView">
        <item name="cardBackgroundColor">@color/accent_cyan_container</item>
        <item name="strokeColor">@color/accent_cyan_dark</item>
    </style>

    <!-- ── Text Inputs ───────────────────────────────────────── -->
    <style name="Observatory.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="errorIconDrawable">@null</item>
        <item name="startIconTint">@color/text_muted</item>
        <item name="endIconTint">@color/text_muted</item>
    </style>

    <style name="Observatory.TextInput.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ── Buttons ───────────────────────────────────────────── -->
    <style name="Observatory.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/ripple_on_surface</item>
    </style>

    <style name="Observatory.Button.Safe" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Observatory.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="rippleColor">@color/ripple_on_surface</item>
    </style>

    <style name="Observatory.Button.Ghost.Cyan" parent="Observatory.Button.Ghost">
        <item name="strokeColor">@color/accent_cyan_dark</item>
        <item name="android:textColor">@color/accent_cyan</item>
    </style>

    <style name="Observatory.Button.Ghost.Amber" parent="Observatory.Button.Ghost">
        <item name="strokeColor">@color/accent_amber_dark</item>
        <item name="android:textColor">@color/accent_amber</item>
    </style>

    <style name="Observatory.Button.Ghost.Red" parent="Observatory.Button.Ghost">
        <item name="strokeColor">@color/accent_red_dim</item>
        <item name="android:textColor">@color/accent_red</item>
    </style>

    <!-- Icon-only button (zoom controls, camera controls) -->
    <style name="Observatory.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <!-- ── Bottom Navigation ──────────────────────────────────  -->
    <style name="Observatory.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/nav_bg</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <!-- fix: itemActiveIndicatorColor does not exist in Material 1.11.0 —
             the active pill is set via itemActiveIndicatorStyle + drawable -->
        <item name="itemActiveIndicatorStyle">@style/Observatory.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Active-tab pill behind the selected destination (nav_indicator red 12%) -->
    <style name="Observatory.ActiveIndicator">
        <item name="android:background">@drawable/bg_nav_indicator</item>
    </style>

    <!-- ── Chips ─────────────────────────────────────────────── -->
    <style name="Observatory.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ── Typography Text Appearances ──────────────────────── -->
    <!-- Implicit-parent base: dotted names (SectionLabel, RiskScore, ...)
         resolve their implicit parent from this style - it must exist. -->
    <style name="TextAppearance.Observatory" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.Observatory.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Observatory.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Observatory.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Observatory.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Observatory.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Observatory.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Section header label (e.g. "درجة الخطورة") -->
    <style name="TextAppearance.Observatory.SectionLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Risk score number -->
    <style name="TextAppearance.Observatory.RiskScore">
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- SOS countdown -->
    <style name="TextAppearance.Observatory.Countdown">
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textSize">90sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <!-- Screen title (e.g. "نداء الاستغاثة") -->
    <style name="TextAppearance.Observatory.ScreenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Accent chip text (GPS / NET / Mesh status) -->
    <style name="TextAppearance.Observatory.StatusChip">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ── Dialog ────────────────────────────────────────────── -->
    <style name="Observatory.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/surface_dialog</item>
        <item name="colorSurface">@color/surface_dialog</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="buttonBarPositiveButtonStyle">@style/Observatory.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Observatory.Button.Ghost</item>
    </style>

    <!-- ── Snackbar ──────────────────────────────────────────── -->
    <style name="Observatory.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:background">@color/surface_elevated</item>
    </style>

</resources>
