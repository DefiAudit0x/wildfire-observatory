<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v2.0.0: Material3 dark, native shell. The window background matches
         the observatory palette; edge-to-edge insets are handled in code
         (targetSdk 36 ignores bar colors on 16+ anyway). -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
