<?xml version="1.0" encoding="utf-8"?>
<!-- v2.16.0 live framing crosshair: brand red at 50% (baked into the JPEG
     telemetry stamp by CameraCaptureFragment). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="1dp" />
            <solid android:color="#80D21034" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="1dp" android:height="44dp" />
            <solid android:color="#80D21034" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="12dp" android:height="12dp" />
            <stroke android:width="1dp" android:color="#80D21034" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
