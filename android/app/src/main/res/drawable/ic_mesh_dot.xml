<?xml version="1.0" encoding="utf-8"?>
<!-- v2.20.0 Neo map marker: soft halo + core dot (glow = 2025). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="26dp" android:height="26dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#333AE8FF" />
        </shape>
    </item>
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:width="12dp" android:height="12dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF3AE8FF" />
        </shape>
    </item>
</layer-list>
