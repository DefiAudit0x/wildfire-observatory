<?xml version="1.0" encoding="utf-8"?>
<!-- v2.20.0 Neo safezone: brand-green rounded square + soft halo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="30dp" android:height="30dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#2E00E676" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:width="18dp" android:height="18dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#FF00E676" />
            <corners android:radius="5dp" />
            <stroke android:width="1.5dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
