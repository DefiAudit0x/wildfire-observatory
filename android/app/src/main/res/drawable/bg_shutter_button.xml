<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2.0 — the shutter: ember gradient disc (same fire palette as the
     primary buttons) with a translucent ring so it reads on any preview. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="#FFF0564E"
        android:endColor="#FFB91C1C"
        android:angle="270" />
    <stroke
        android:width="3dp"
        android:color="#B3FFFFFF" />
    <size
        android:width="74dp"
        android:height="74dp" />
</shape>
