<?xml version="1.0" encoding="utf-8"?>
<!-- v2.8.0 — the shutter: red-600 gradient disc (same primary system as the
     buttons) with a translucent ring so it reads on any preview. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="#FFDC2626"
        android:endColor="#FF991B1B"
        android:angle="270" />
    <stroke
        android:width="3dp"
        android:color="#B3FFFFFF" />
    <size
        android:width="74dp"
        android:height="74dp" />
</shape>
