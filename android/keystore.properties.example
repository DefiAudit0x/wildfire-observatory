# Release-signing credentials — COPY to android/keystore.properties and
# fill in real values. keystore.properties is gitignored and must NEVER
# be committed. The keystore file itself lives OUTSIDE the repository.
# CI receives the same values as GitHub Actions secrets (see .github/
# workflows/android.yml "Restore signing keystore").
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=wildfire
keyPassword=CHANGE_ME
