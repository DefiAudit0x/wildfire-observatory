# ===========================================
# VIGIL — Production Environment
# ALL variables must be set before deployment
# ===========================================

JWT_SECRET=change-this-to-a-random-64-char-string
SUPER_ADMIN_PASSWORD=change-this-too
ADMIN_PASSWORD=change-this-too
NASA_FIRMS_KEY=your-nasa-firms-key-here
NODE_ENV=production
LOG_LEVEL=info

# Optional but recommended
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# GRAPHHOPPER_KEY=your-graphhopper-key
# OWM_KEY=your-openweathermap-key
# MAPBOX_TOKEN=your-mapbox-token

# Monitoring
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
