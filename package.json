{
  "name": "north-african-wildfire-observatory",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/server.ts",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:react": "vitest run --config vitest.config.ts",
    "test:e2e": "E2E_DURABLE_ASSERTION=true firebase emulators:exec --only firestore --project demo-wildfire-observatory-e2e --config firebase.json \"playwright test --config playwright.config.ts\"",
    "test": "npm run test:server && npm run test:react",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/hashes": "1.8.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.0",
    "pino": "^10.3.0",
    "pino-pretty": "^12.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "workbox-window": "7.4.1",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.27.0",
    "husky": "^9.1.0",
    "jsdom": "^30.0.1",
    "motion": "^12.23.24",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
